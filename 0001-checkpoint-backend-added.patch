ए कोई पूर्व अनुभव आवश्यक नहीं है। हम आध्यात्मिक साधकों, उपचारकों, कोच, चिकित्सकों और जिज्ञासु व्यक्तियों का स्वागत करते हैं। मध्यम और उन्नत कोर्स के लिए, हम फाउंडेशन कोर्स पूरा करने या कम से कम 6 महीने का अनुभव होने की सलाह देते हैं।",category:"Courses"},{id:"4",question:"परामर्श या रीडिंग सत्र कैसे बुक करें?",answer:"इस पेज के परामर्श अनुभाग में हमारा बुकिंग फॉर्म भरें, या 'परामर्श बुक करें' बटन का उपयोग करें। अपनी वांछित सेवा, पसंदीदा तिथि/समय चुनें। आपको 24 घंटों के भीतर पुष्टि मिलेगी और भुगतान विवरण ईमेल के माध्यम से साझा किए जाएंगे।",category:"Booking"},{id:"5",question:"क्या रीडिंग ऑनलाइन या ऑफलाइन होती है?",answer:"हम मुख्यतः ऑनलाइन वीडियो कॉल के माध्यम से रीडिंग प्रदान करते हैं। स्थानीय ग्राहकों के लिए विशेष अनुरोध पर व्यक्तिगत सत्र की व्यवस्था की जा सकती है। दोनों प्रारूप समान रूप से प्रभावी हैं, क्योंकि आकाशिक ऊर्जा भौतिक स्थान और समय से परे है।",category:"Sessions"},{id:"6",question:"सत्र किस भाषा में आयोजित होते हैं?",answer:"सत्र वर्तमान में अंग्रेजी और हिंदी में आयोजित किए जाते हैं। हम निकट भविष्य में अतिरिक्त क्षेत्रीय भाषाओं में विस्तार करने पर काम कर रहे हैं।",category:"General"},{id:"7",question:"एक रीडिंग सत्र कितने समय का होता है?",answer:"एक मानक व्यक्तिगत रीडिंग सत्र 60–90 मिनट का होता है। विशिष्ट प्रश्नों के लिए मिनी रीडिंग 30 मिनट की होती है। हमारी सोल ब्लूप्रिंट रीडिंग 2 घंटे की होती है। अपने निर्धारित समय से 5 मिनट पहले तैयार रहें।",category:"Sessions"},{id:"8",question:"रीडिंग कितनी सटीक होती है?",answer:"आकाशिक रीडिंग आध्यात्मिक मार्गदर्शन और अंतर्दृष्टि प्रदान करती है — यह भविष्य बताना नहीं है। सटीकता आपके प्रश्नों की स्पष्टता और ग्रहण करने की आपकी खुलेपन पर निर्भर करती है। कई ग्राहक 80–95% प्रतिध्वनि की रिपोर्ट करते हैं।",category:"General"},{id:"9",question:"पहले सत्र में क्या उम्मीद करें?",answer:"आपका पहला सत्र एक संक्षिप्त परिचय और इरादा निर्धारण के साथ शुरू होता है। रीडर आपके रिकॉर्ड्स खोलेगा और आपको आत्मा यात्रा, जीवन विषयों और प्रश्नों के उत्तर मिलेंगे। अपने प्रश्न पहले से लिखकर आएं।",category:"Sessions"},{id:"10",question:"क्या कोर्स के लिए किस्त भुगतान उपलब्ध है?",answer:"हाँ! हम ₹5,000 से अधिक के सभी कोर्स के लिए आसान किस्त योजनाएं प्रदान करते हैं। आप भुगतान को 2–3 किस्तों में विभाजित कर सकते हैं। हम वास्तविक साधकों के लिए कभी-कभी छात्रवृत्ति भी प्रदान करते हैं। भुगतान विकल्पों के लिए सीधे संपर्क करें।",category:"Courses"}]},contact:{tagline:"हम आपके लिए यहाँ हैं",heading:"हमसे",headingItalic:"संपर्क करें",desc:"प्रश्नों, बुकिंग पूछताछ, या बस नमस्ते कहने के लिए संपर्क करें। हम यात्रा पर आत्माओं से जुड़ना पसंद करते हैं।",contactLabels:["फ़ोन / WhatsApp","ईमेल पता","Instagram","Facebook","स्थान"],hoursTitle:"सत्र का समय",hours:[{day:"सोमवार – शुक्रवार",time:"9:00 AM – 8:00 PM IST"},{day:"शनिवार",time:"10:00 AM – 6:00 PM IST"},{day:"रविवार",time:"केवल अपॉइंटमेंट पर"}],globalTitle:"विश्वव्यापी सेवा",globalDesc:"सभी सत्र Zoom या Google Meet के माध्यम से ऑनलाइन आयोजित किए जाते हैं। हम लचीले शेड्यूलिंग के साथ सभी समय क्षेत्रों को समायोजित करते हैं।",whatsappCTA:"WhatsApp पर चैट करें",formTitle:"हमें संदेश भेजें",formSubtitle:"नीचे फॉर्म भरें और हम जल्द से जल्द आपसे संपर्क करेंगे।",labelName:"आपका नाम *",labelEmail:"ईमेल पता *",labelSubject:"विषय *",labelMessage:"संदेश *",placeholderName:"आपका पूरा नाम",placeholderEmail:"your@email.com",placeholderSubject:"आप क्या चर्चा करना चाहते हैं?",placeholderMessage:"अपने बारे में बताएं और यहाँ क्यों आए...",submitBtn:"संदेश भेजें",submitting:"भेज रहे हैं...",successTitle:"संदेश भेजा गया!",successDesc:"हम 24 घंटों के भीतर आपसे संपर्क करेंगे। संपर्क करने के लिए धन्यवाद! ✨",validationName:"नाम आवश्यक है",validationEmail:"ईमेल आवश्यक है",validationEmailInvalid:"वैध ईमेल दर्ज करें",validationSubject:"विषय आवश्यक है",validationMessage:"संदेश आवश्यक है",validationMessageShort:"कृपया कम से कम 20 अक्षर लिखें"},footer:{taglineSmall:"रीडिंग और परामर्श",brandDesc:"आकाशिक रीडिंग की कालातीत बुद्धि के माध्यम से आत्माओं को स्पष्टता, उपचार और उद्देश्य की ओर मार्गदर्शन। समझ की आपकी यात्रा यहाँ शुरू होती है।",newsletterTitle:"पवित्र ज्ञान से जुड़े रहें",newsletterDesc:"अंतर्